      },
      "predictiveBackGestureEnabled": false,
      "package": "com.starry51234.expotodoapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ee884e21-f836-4d73-884b-d6b7d379422a"
      }
